# "local" (default) reads/writes local-data/ — no repos needed yet.
# "github" switches the whole app onto the real repos below.
# NOTE: DATABASE_REPO is filled in below, but WEBSITE_REPO is still empty —
# GithubProvider requires both, so flipping this to "github" before
# WEBSITE_REPO is set will throw on startup. See README/chat for what the
# website repo needs to contain.
DATA_PROVIDER=github

# --- Only needed once DATA_PROVIDER=github -----------------------------
# Fine-grained PAT (or GitHub App token) with Contents: read+write on the
# database repo, and at least Contents: read on the website repo.
# In Cloudflare Pages this is set as an encrypted secret, never committed.
GITHUB_TOKEN=

# "owner/name" for each repo.
WEBSITE_REPO=manali-earth/portfolio
WEBSITE_BRANCH=main

DATABASE_REPO=manali-earth/database
DATABASE_BRANCH=main
