# "local" (default) reads/writes local-data/ — no repos needed yet.
# "github" switches the whole app onto the real repos below.
DATA_PROVIDER=github

# --- Only needed once DATA_PROVIDER=github -----------------------------
# Fine-grained PAT (or GitHub App token) with Contents: read+write on the
# database repo. It is only required for Save; public database repositories
# can be loaded without it. In Cloudflare this is set as an encrypted secret.
GITHUB_TOKEN=

# The database repository contains database.json and all page JSON files.
DATABASE_REPO=manali-earth/database
DATABASE_BRANCH=main
# Optional; defaults to database.json at the database repository root.
DATABASE_INDEX_PATH=database.json

# Optional private website repository containing the index instead. When set,
# its database index is used and GITHUB_TOKEN is required for loading it.
# WEBSITE_REPO=owner/private-website
# WEBSITE_BRANCH=main
# WEBSITE_INDEX_PATH=database/database.json
