-{"page": "gis-projects", "title": "GIS Projects", "heading": "GIS and Remote Sensing Projects", "intro": "Here are some of the recent geospatial projects answering environment-related spatial questions, using tools like ArcGIS Pro, Google Earth Engine, QGIS, GeoDa, Python, and R to analyze, visualize, and map meaningful insights — from detecting LULC change with a Random Forest machine learning model to regression models, vulnerability assessments, and hotspot analysis.", "projects": [{"id": "climate-regions", "title": "Classify climate regions with Python - ESRI Tutorial", "image": "projects/project-1.jpg", "meta": "ArcGIS Pro · Python Notebook", "summary": "Tool used: ArcGIS Pro (Python Notebook). Skills applied: multidimensional raster analysis, Winkler Index calculation, climate zoning. Dataset: NASA Daymet daily max/min temperature (2000-2020). A self-paced project from Learn ArcGIS by Esri authors Lain Graham, Josh Grail, Cole Walts, and Hong Xu. Mapped viticultural climate zoning in Napa County, California, using a 21-year subset of NASA's Daymet dataset. Growing Degree Days were calculated per pixel for each year to assess cumulative heat units, and the resulting values were used to classify the region into six Winkler Index climate zones, a widely accepted framework in viticulture. A temporal chart visualized how these zones shifted over time, providing insight into the ongoing impacts of climate change on Napa's wine industry.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tool used: ArcGIS Pro (Python Notebook). Skills applied: multidimensional raster analysis, Winkler Index calculation, climate zoning. Dataset: NASA Daymet daily max/min temperature (2000-2020). A self-paced project from Learn ArcGIS by Esri authors Lain Graham, Josh Grail, Cole Walts, and Hong Xu. Mapped viticultural climate zoning in Napa County, California, using a 21-year subset of NASA's Daymet dataset. Growing Degree Days were calculated per pixel for each year to assess cumulative heat units, and the resulting values were used to classify the region into six Winkler Index climate zones, a widely accepted framework in viticulture. A temporal chart visualized how these zones shifted over time, providing insight into the ongoing impacts of climate change on Napa's wine industry."}]}]}, {"id": "urbanization-pattern", "title": "Urbanization pattern using Machine Learning on Google Earth Engine", "image": "projects/project-2.jpg", "meta": "Google Earth Engine · Random Forest", "summary": "Tool used: Google Earth Engine, ArcGIS Pro. Skills applied: Random Forest classification, LULC change detection, remote sensing, land surface temperature analysis. Dataset: Landsat imagery (2000-2020). Independent research (MS thesis work). Analyzed Land Use Land Cover change across nine South Asian cities over a 20-year period using the Random Forest machine learning algorithm: Rajshahi and Chattogram in Bangladesh, Ahmedabad, Bhubaneswar, and Kanpur in India, Gwadar and Quetta in Pakistan, Kathmandu in Nepal, and Kabul in Afghanistan. Satellite imagery was classified into urban, vegetation, water, and bare land categories, revealing a substantial increase in built-up areas often replacing natural land covers. The study also assessed the impact of urbanization on land surface temperature, highlighting spatial correlations between urban growth and thermal intensity.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tool used: Google Earth Engine, ArcGIS Pro. Skills applied: Random Forest classification, LULC change detection, remote sensing, land surface temperature analysis. Dataset: Landsat imagery (2000-2020). Independent research (MS thesis work). Analyzed Land Use Land Cover change across nine South Asian cities over a 20-year period using the Random Forest machine learning algorithm: Rajshahi and Chattogram in Bangladesh, Ahmedabad, Bhubaneswar, and Kanpur in India, Gwadar and Quetta in Pakistan, Kathmandu in Nepal, and Kabul in Afghanistan. Satellite imagery was classified into urban, vegetation, water, and bare land categories, revealing a substantial increase in built-up areas often replacing natural land covers. The study also assessed the impact of urbanization on land surface temperature, highlighting spatial correlations between urban growth and thermal intensity."}]}]}, {"id": "nyc-hotspots", "title": "Spatiotemporal Hotspot and Outlier Analysis in New York City", "image": "projects/project-3.jpg", "meta": "ArcGIS Pro · Space-Time Cube", "summary": "Tool used: ArcGIS Pro. Skills applied: space-time cube, emerging hotspot analysis, local outlier analysis, 3D visualization. Dataset: eight years of graffiti incidents in NYC. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis, Auburn University. Explored temporal and spatial patterns of urban graffiti incidents in New York using ArcGIS Pro's space-time cube tools. By constructing a 3D space-time cube and performing Emerging Hotspot and Local Outlier Analysis, evolving clusters and anomalies over time were identified, visualizing not just where but when high or low incident patterns occurred, offering insights for urban planning and policy.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tool used: ArcGIS Pro. Skills applied: space-time cube, emerging hotspot analysis, local outlier analysis, 3D visualization. Dataset: eight years of graffiti incidents in NYC. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis, Auburn University. Explored temporal and spatial patterns of urban graffiti incidents in New York using ArcGIS Pro's space-time cube tools. By constructing a 3D space-time cube and performing Emerging Hotspot and Local Outlier Analysis, evolving clusters and anomalies over time were identified, visualizing not just where but when high or low incident patterns occurred, offering insights for urban planning and policy."}]}]}, {"id": "calls-911-regression", "title": "Regression and Spatial Analysis of 911 Calls Using ArcGIS Pro", "meta": "ArcGIS Pro · GWR", "summary": "Tools used: ArcGIS Pro. Skills applied: Ordinary Least Squares (OLS), Explanatory Regression, Geographically Weighted Regression (GWR), spatial autocorrelation. Dataset: 911 call incident data. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis. Analyzed the spatial distribution of 911 calls to understand the relationship between emergency incidents and socio-economic variables. Ordinary Least Squares first tested individual and combined explanatory variables including population, job count, low education percentage, and distance to the urban center, and Explanatory Regression was used to select the best-fitting model based on Adjusted R2, AIC, and residual statistics. Geographically Weighted Regression then revealed that the influence of population and other variables varied significantly across space, improving on the global model with a lower AIC and a higher Adjusted R2 of 0.86. The final spatial prediction map identified future high-risk areas for 911 calls, aiding proactive emergency response planning.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tools used: ArcGIS Pro. Skills applied: Ordinary Least Squares (OLS), Explanatory Regression, Geographically Weighted Regression (GWR), spatial autocorrelation. Dataset: 911 call incident data. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis. Analyzed the spatial distribution of 911 calls to understand the relationship between emergency incidents and socio-economic variables. Ordinary Least Squares first tested individual and combined explanatory variables including population, job count, low education percentage, and distance to the urban center, and Explanatory Regression was used to select the best-fitting model based on Adjusted R2, AIC, and residual statistics. Geographically Weighted Regression then revealed that the influence of population and other variables varied significantly across space, improving on the global model with a lower AIC and a higher Adjusted R2 of 0.86. The final spatial prediction map identified future high-risk areas for 911 calls, aiding proactive emergency response planning."}]}]}, {"id": "density-heatmap-geoda", "title": "Density and Heat Map Analysis Using ArcGIS and GeoDa", "meta": "ArcGIS Pro · GeoDa", "summary": "Tool used: ArcGIS Pro, GeoDa. Skills applied: kernel density estimation, heat map generation, spatial pattern analysis. Dataset: wildfire incident points. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis. Demonstrated surface analysis techniques by creating both simple density and kernel density surfaces to visualize concentrations of wildfire incidents, and developed a heat map to highlight spatial intensity. GeoDa was used to explore spatial clustering and autocorrelation, deepening an understanding of spatial data distribution.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tool used: ArcGIS Pro, GeoDa. Skills applied: kernel density estimation, heat map generation, spatial pattern analysis. Dataset: wildfire incident points. Course: GEOG 6700 - Quantitative Methods and Spatial Analysis. Demonstrated surface analysis techniques by creating both simple density and kernel density surfaces to visualize concentrations of wildfire incidents, and developed a heat map to highlight spatial intensity. GeoDa was used to explore spatial clustering and autocorrelation, deepening an understanding of spatial data distribution."}]}]}, {"id": "natural-resource-clustering", "title": "County-Level Spatial Clustering of Natural Resource Employment", "meta": "GeoDa · LISA", "summary": "Tool used: GeoDa. Skills applied: Local Indicators of Spatial Association (LISA), cluster analysis, thematic mapping. Dataset: county-wise natural resource employment across the southeastern U.S. Visualized spatial clustering of natural resource employment across southeastern U.S. counties using LISA Cluster Analysis. High-High clusters represent counties with significantly high employment surrounded by similarly high counties, while Low-Low clusters indicate areas of consistently low employment, supporting identification of regional economic patterns to inform targeted development or conservation policies.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tool used: GeoDa. Skills applied: Local Indicators of Spatial Association (LISA), cluster analysis, thematic mapping. Dataset: county-wise natural resource employment across the southeastern U.S. Visualized spatial clustering of natural resource employment across southeastern U.S. counties using LISA Cluster Analysis. High-High clusters represent counties with significantly high employment surrounded by similarly high counties, while Low-Low clusters indicate areas of consistently low employment, supporting identification of regional economic patterns to inform targeted development or conservation policies."}]}]}, {"id": "heat-vulnerability-chattogram", "title": "Heat Vulnerability Index Map of Chattogram City", "meta": "ArcGIS Pro · Remote Sensing", "summary": "A map illustrating heat vulnerability in Chattogram City Corporation, combining physical exposure indicators (land surface temperature, NDVI, NDBI, NDWI) with social indicators (income, housing, age, and more) to highlight the areas most affected by heat vulnerability.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "A map illustrating heat vulnerability in Chattogram City Corporation, combining physical exposure indicators (land surface temperature, NDVI, NDBI, NDWI) with social indicators (income, housing, age, and more) to highlight the areas most affected by heat vulnerability."}]}]}, {"id": "air-pollution-alabama", "title": "Air Pollution of Alabama and Correlation with Population using GIS Interpolation", "meta": "ArcGIS Pro · IDW Interpolation", "summary": "Explored the spatial relationship between PM2.5 air pollution levels and population density across Alabama counties using ArcGIS Pro. Key techniques included data integration, spatial interpolation with the Inverse Distance Weighting (IDW) method, and zonal statistics on air quality data from the USEPA alongside population data from the US Census. Montgomery had the highest PM2.5 levels (11.12 micrograms per cubic meter), though this did not consistently correlate with population density elsewhere, suggesting industrial activity and geography also influence air quality. A temporal comparison between 2018 and 2020 revealed minimal change in pollution levels during the COVID-19 pandemic, challenging assumptions about decreased human activity leading to cleaner air.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Explored the spatial relationship between PM2.5 air pollution levels and population density across Alabama counties using ArcGIS Pro. Key techniques included data integration, spatial interpolation with the Inverse Distance Weighting (IDW) method, and zonal statistics on air quality data from the USEPA alongside population data from the US Census. Montgomery had the highest PM2.5 levels (11.12 micrograms per cubic meter), though this did not consistently correlate with population density elsewhere, suggesting industrial activity and geography also influence air quality. A temporal comparison between 2018 and 2020 revealed minimal change in pollution levels during the COVID-19 pandemic, challenging assumptions about decreased human activity leading to cleaner air."}]}]}, {"id": "lulc-temp-correlation", "title": "Correlation between LULC vs Temp: LST vs NDBI/NDVI/NDWI", "meta": "Google Earth Engine · R", "summary": "Nine scatter plots comparing land surface temperature with MNDWI, NDVI, and NDBI across nine different cities, providing a comprehensive comparison of the relationships between LST and built-up area, vegetation, and waterbodies. Indices were extracted from the Google Earth Engine platform and graphs were produced using R.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Nine scatter plots comparing land surface temperature with MNDWI, NDVI, and NDBI across nine different cities, providing a comprehensive comparison of the relationships between LST and built-up area, vegetation, and waterbodies. Indices were extracted from the Google Earth Engine platform and graphs were produced using R."}]}]}, {"id": "lst-hotspot-south-asia", "title": "Spatiotemporal Hotspot Analysis of Land Surface Temperature in South Asia", "meta": "Google Earth Engine · Space-Time Cube", "summary": "Tools used: Google Earth Engine (JavaScript), ArcGIS Pro. Skills applied: MODIS LST extraction, space-time cube, emerging hotspot analysis. Dataset: MODIS land surface temperature (8-day, 1 km), 2013-2023. Extracted decadal LST values in Google Earth Engine and analyzed them in ArcGIS Pro with Space-Time Cube and Emerging Hotspot tools. The analysis identified intensifying heat zones in India, Pakistan, and Afghanistan, while cooler trends were observed in Nepal, Bhutan, and Sri Lanka, offering regional insight into urban heat dynamics to support climate resilience planning.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Tools used: Google Earth Engine (JavaScript), ArcGIS Pro. Skills applied: MODIS LST extraction, space-time cube, emerging hotspot analysis. Dataset: MODIS land surface temperature (8-day, 1 km), 2013-2023. Extracted decadal LST values in Google Earth Engine and analyzed them in ArcGIS Pro with Space-Time Cube and Emerging Hotspot tools. The analysis identified intensifying heat zones in India, Pakistan, and Afghanistan, while cooler trends were observed in Nepal, Bhutan, and Sri Lanka, offering regional insight into urban heat dynamics to support climate resilience planning."}]}]}, {"id": "dhaka-lulc-landsat", "title": "LULC Change Detection of Dhaka City using Landsat", "meta": "ERDAS Imagine · Landsat", "summary": "Using Landsat 7 and 8 imagery, this study classified land cover in Dhaka in 2005 and 2020 with unsupervised classification in ERDAS Imagine. The analysis revealed a 24.69% increase in built-up area and a sharp decline in ecological land uses, including a 21.63% loss in vegetation, 37.56% in agricultural land, and 16.12% in water bodies. The classification achieved 91.6% overall accuracy.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Using Landsat 7 and 8 imagery, this study classified land cover in Dhaka in 2005 and 2020 with unsupervised classification in ERDAS Imagine. The analysis revealed a 24.69% increase in built-up area and a sharp decline in ecological land uses, including a 21.63% loss in vegetation, 37.56% in agricultural land, and 16.12% in water bodies. The classification achieved 91.6% overall accuracy."}]}]}, {"id": "water-from-above", "title": "Water level from above", "image": "home/project-3.jpg", "meta": "NASA SWOT · Machine Learning", "summary": "Exploring NASA SWOT data and machine learning to understand water-level dynamics in the Great Salt Lake Basin.", "sections": [{"heading": "", "content": [{"type": "paragraph", "text": "Exploring NASA SWOT data and machine learning to understand water-level dynamics in the Great Salt Lake Basin."}]}]}]}
